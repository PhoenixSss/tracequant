# tracequant WSL2 GitHub Evidence Runner rules
#
# Allow only the fixed repository Evidence Runner and named profile prefixes.
# The Runner validates exact argv, repository identity, fixed GitHub queries,
# fixed read-only Git operations, snapshot identity, and ignored output paths.
# It accepts no arbitrary repository, API path, raw gh/Git argv, shell, cwd, or
# output path.

prefix_rule(
    pattern = ["tools/agent_workflow/wsl2_github_evidence_runner.py", ["delivery", "delivery-readiness", "review", "review-terminal", "pre-merge", "closeout-readonly", "recheck"]],
    decision = "allow",
    justification = "Allow named fixed read-only Evidence Runner profiles; the Runner validates complete argv and object identities.",
)

prefix_rule(
    pattern = ["tools/agent_workflow/wsl2_github_evidence_runner.py", ["delivery", "delivery-readiness", "review", "review-terminal", "pre-merge", "closeout-readonly", "recheck"], ["--repo", "--repository", "--api", "--graphql", "--gh-arg", "--git-arg", "--shell", "--exec", "--", "|", ">", "$(id)"]],
    decision = "forbidden",
    justification = "Block repository/API/command injection and shell metacharacter forms.",
)

prefix_rule(
    pattern = ["gh", "auth", "token"],
    decision = "forbidden",
    justification = "Never print GitHub authentication tokens.",
)

prefix_rule(
    pattern = ["git", ["add", "commit", "switch", "checkout", "fetch", "push", "branch", "reset", "clean", "merge", "rebase", "cherry-pick", "revert"]],
    decision = "prompt",
    justification = "Git writes, ref refresh, branch operations, history changes, and destructive commands require explicit workflow approval.",
)

prefix_rule(
    pattern = ["gh", ["issue", "pr", "project", "api"]],
    decision = "prompt",
    justification = "Direct GitHub CLI and API calls require explicit approval; the fixed Evidence Runner is the normal read-only entry.",
)
