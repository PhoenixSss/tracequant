{
  "schema_version": 1,
  "runner_version": "1.3.0",
  "repository": "PhoenixSss/tracequant",
  "profiles": {
    "delivery": {
      "operation": "delivery-preflight",
      "required_arguments": [
        "task",
        "expected_main_sha",
        "entry_point",
        "branch",
        "pr",
        "expected_base_sha",
        "expected_head_sha",
        "validation_result",
        "verify",
        "push_verification_result"
      ],
      "description": "Unified Delivery Invocation Preflight with lifecycle-conflict detection across six stable semantic entry points."
    },
    "delivery-readiness": {
      "operation": "delivery-readiness",
      "required_arguments": [
        "task",
        "pr",
        "expected_base_sha",
        "expected_head_sha"
      ],
      "description": "Delivery handoff snapshot for a review-ready Task PR."
    },
    "review": {
      "operation": "pr-review-snapshot",
      "required_arguments": [
        "task",
        "pr",
        "expected_base_sha",
        "expected_head_sha"
      ],
      "description": "Independent review snapshot for the locked PR base and head."
    },
    "pre-merge": {
      "operation": "pr-review-snapshot",
      "required_arguments": [
        "task",
        "pr",
        "expected_base_sha",
        "expected_head_sha"
      ],
      "description": "Final read-only identity, checks, threads, and drift snapshot before manual merge."
    },
    "closeout-readonly": {
      "operation": "closeout-plan",
      "required_arguments": [
        "task",
        "pr",
        "expected_head_sha",
        "expected_merge_sha"
      ],
      "description": "Read-only post-merge Task/PR/main convergence evidence."
    },
    "recheck": {
      "operation": "recheck",
      "required_arguments": [
        "snapshot_id"
      ],
      "description": "Recollect a stored snapshot using its supported stability recheck operation."
    }
  }
}
