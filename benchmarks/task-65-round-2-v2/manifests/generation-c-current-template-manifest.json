{
  "schema_version": 1,
  "protocol_identity": "task-65-round-2-v2",
  "kind": "template",
  "generation_id": "C",
  "agent_identity": {
    "agent": "codex",
    "generation_name": "current-codex",
    "discovery_adapter": "codex-rollout",
    "runtime_environment": "codex-runtime"
  },
  "source_selector": {
    "kind": "fixed-commit",
    "ref": "BENCHMARK_BASE_SHA"
  },
  "closure_derivation_rules": {
    "path_classes": [
      {"glob": ".agents/skills/task-delivery/SKILL.md", "role": "OPTIONAL_HISTORICAL_LIMITATION"},
      {"glob": ".agents/skills/task-pr-review/SKILL.md", "role": "OPTIONAL_HISTORICAL_LIMITATION"},
      {"glob": "tools/agent_workflow/*.py", "role": "EXECUTION_REQUIRED"},
      {"glob": "tools/agent_workflow/*.json", "role": "VALIDATION_PRESENCE_REQUIRED"},
      {"glob": "tests/tools/**", "role": "VALIDATION_PRESENCE_REQUIRED"},
      {"glob": ".agents/execution-profile.example.toml", "role": "VALIDATION_PRESENCE_REQUIRED"},
      {"glob": ".agents/policies/*.md", "role": "VALIDATION_PRESENCE_REQUIRED"},
      {"glob": ".agents/skills/*/SKILL.md", "role": "VALIDATION_PRESENCE_REQUIRED"},
      {"glob": ".claude/skills/*/SKILL.md", "role": "VALIDATION_PRESENCE_REQUIRED"},
      {"glob": ".claude/settings.json", "role": "VALIDATION_PRESENCE_REQUIRED"},
      {"glob": ".codex/rules/*.rules", "role": "VALIDATION_PRESENCE_REQUIRED"},
      {"glob": "AGENTS.md", "role": "IDENTITY_REQUIRED"},
      {"glob": "CLAUDE.md", "role": "IDENTITY_REQUIRED"},
      {"glob": "docs/development/issue-workflow.md", "role": "IDENTITY_REQUIRED"},
      {"glob": "docs/development/pr-review.md", "role": "IDENTITY_REQUIRED"}
    ],
    "excluded_paths": [
      ".agents/evidence.local",
      ".agents/validation.local",
      ".agents/benchmark-fixtures.local"
    ],
    "first_match_wins": true
  },
  "expected_workflow_path_classes": [
      "tools/agent_workflow/*.py",
      "tools/agent_workflow/*.json",
      "tests/tools/**",
      ".agents/execution-profile.example.toml",
    ".agents/policies/*.md",
    ".agents/skills/*/SKILL.md",
    ".claude/skills/*/SKILL.md",
    ".claude/settings.json",
    ".codex/rules/*.rules",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/development/issue-workflow.md",
    "docs/development/pr-review.md"
  ],
  "role_classification_rules": {
    "projection_defaults": {
      "EXECUTION_REQUIRED": "INSTALL_GENERATION_VERSION",
      "VALIDATION_PRESENCE_REQUIRED": "INSTALL_GENERATION_VERSION",
      "IDENTITY_REQUIRED": "INSTALL_GENERATION_VERSION",
      "OPTIONAL_HISTORICAL_LIMITATION": "INHERIT_BUSINESS_BASE"
    },
    "identity_required_must_be_explicit": true,
    "optional_historical_limitation_default": "not-installed",
    "runtime_install_false_is_not_a_decision": true,
    "role_action_mapping": {
      "EXECUTION_REQUIRED": "INSTALL_GENERATION_VERSION (default)",
      "VALIDATION_PRESENCE_REQUIRED": "INSTALL_GENERATION_VERSION (default)",
      "IDENTITY_REQUIRED": "explicit per-file INSTALL / INHERIT / ABSENT + reason (declared above; no implicit default)",
      "OPTIONAL_HISTORICAL_LIMITATION": "default not installed (INHERIT_BUSINESS_BASE); install only with explicit historical runtime evidence + reason"
    }
  },
  "materializer_contract": {
    "verbatim_blob_extraction": true,
    "deterministic": true,
    "idempotent": true,
    "no_synthetic_repair": true,
    "no_current_generation_fallback": true,
    "no_cross_generation_shared_runtime_file": true,
    "no_symlink": true,
    "validate_git_file_mode": true,
    "fail_closed_conditions": [
      "source path missing",
      "blob mismatch",
      "sha256 mismatch",
      "manifest/source identity mismatch"
    ]
  },
  "validation_contract": {
    "control_base_validator": "control_base_validator.py --arm <ARM> --benchmark-base-sha <BENCHMARK_BASE_SHA> --control-base-sha <ARM_CONTROL_BASE_SHA>",
    "cd_file_identity_report": "required at freeze after run-lock: complete path/blob/hash identity; any unexpected file-set/blob/hash difference -> HUMAN GATE, formal C vs D comparison must not continue",
    "c_d_frozen_tip": "ARM_CONTROL_BASE_SHA = BENCHMARK_BASE_SHA (no synthetic commit; arm known from the run-locked manifest filename)",
    "worktree_clean_required": true
  },
  "invocation_contract": {
    "skill_roots": [".agents/skills", ".claude/skills"],
    "evidence": "tools/agent_workflow/wsl2_github_evidence_runner.py delivery|delivery-readiness ...",
    "validation": "tools/agent_workflow/wsl2_validation_runner.py workflow-delivery --base-sha <base> ...",
    "pr_resolve": "tools/agent_workflow/pr_resolve.py (generation-native fail-closed identity validation)",
    "pr_contract": "OPEN NON-DRAFT; PR body contains native 'Closes #65'; DO NOT MERGE; base = frozen control-base branch",
    "closing_linkage": "must come from ENSURE-LINKED-BUSINESS-BRANCH -> PR Development linkage promotion (closing keyword is native contract only, not an evidence source)"
  },
  "permission_discovery_identity": {
    "codex_rules": [".codex/rules/tracequant-wsl-evidence.rules", ".codex/rules/tracequant-wsl-validation.rules"],
    "claude_settings": [".claude/settings.json"],
    "user_global_config": "excluded from fixture closure (environment manifest, owned by #86)"
  },
  "file_identity_rule": {
    "generations": ["C", "D"],
    "complete_source_path_set_identical": true,
    "per_path_blob_identical": true,
    "per_path_sha256_identical": true,
    "allowed_differences": [
      "agent identity",
      "discovery adapter",
      "invocation identity",
      "permission/runtime environment identity",
      "session/evidence identity"
    ],
    "no_per_agent_pruned_closure": true,
    "no_symlink": true,
    "independent_materialization": true
  }
}
