{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-65-round-2-v2 Arm identity",
  "description": "Schema for one Arm identity record of the task-65-round-2-v2 benchmark. Preparation defines the schema; #86 instantiates real values.",
  "protocol_identity": "task-65-round-2-v2",
  "schema_version": 1,
  "type": "object",
  "required": [
    "arm_id",
    "agent",
    "generation_id",
    "branch_name_template",
    "control_base_branch",
    "business_branch",
    "pr_title_template",
    "pr_state",
    "pr_draft",
    "merge_allowed",
    "auto_merge_allowed",
    "closeout_allowed",
    "issue_link",
    "base_sha",
    "expected_base_sha",
    "expected_head_sha",
    "workspace_id",
    "delivery_session_id",
    "review_session_id",
    "evidence_namespace",
    "rollout_namespace",
    "dynamic_secret_identity_set"
  ],
  "properties": {
    "arm_id": {"type": "string", "enum": ["A", "B", "C", "D"]},
    "agent": {"type": "string", "enum": ["codex", "claude"]},
    "generation_id": {
      "type": "string",
      "enum": [
        "legacy-no-unified-runner-codex",
        "legacy-unified-runner-codex",
        "current-codex",
        "current-claude"
      ]
    },
    "branch_name_template": {"type": "string"},
    "control_base_branch": {"type": "string"},
    "business_branch": {"type": "string"},
    "pr_title_template": {"type": "string"},
    "pr_state": {"const": "OPEN"},
    "pr_draft": {"const": false},
    "merge_allowed": {"const": false},
    "auto_merge_allowed": {"const": false},
    "closeout_allowed": {"const": false},
    "issue_link": {"const": "Closes #65"},
    "base_sha": {"type": "string"},
    "expected_base_sha": {"type": "string"},
    "expected_head_sha": {"type": "string"},
    "workspace_id": {"type": "string"},
    "delivery_session_id": {"type": "string"},
    "review_session_id": {"type": "string"},
    "evidence_namespace": {"type": "string"},
    "rollout_namespace": {"type": "string"},
    "dynamic_secret_identity_set": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
