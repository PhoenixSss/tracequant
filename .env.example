# Copy variable names from this file into your shell, IDE, or env-file tooling.
# The application does not parse .env files automatically.

QUANT_SYSTEM_ENV=development
QUANT_SYSTEM_LOG_LEVEL=INFO
QUANT_SYSTEM_LOG_FORMAT=text

# Empty means file logging is disabled. Directory creation belongs to logging setup.
QUANT_SYSTEM_LOG_DIR=
